# Storybook Storage Service — environment (copy to .env; NEVER commit .env)

# --- REQUIRED ---
# Public base URL used to BUILD persisted URLs + sign GETs. No trailing slash.
# Dev: point at the local nginx (docker) that serves /files/. Falls back fine to
# the FastAPI host if you only exercise the write API.
STORAGE_PUBLIC_BASE_URL=http://localhost:8080
# HMAC secret for signed GET. SECRET — rotate = invalidate all live signed URLs.
STORAGE_SIGN_SECRET=dev-storage-sign-secret-change-me

# --- Driver / disk ---
STORAGE_DRIVER=local-fs
# Dev root (gitignored). Prod: a dedicated volume, e.g. /var/lib/storybook-storage.
STORAGE_ROOT=./.storage-dev

# --- Auth ---
# JSON map name->key. Empty => every S2S route is fail-closed (401). SECRET values.
STORAGE_API_KEYS={"image-api":"dev-image-api-key","swap-service":"dev-swap-key","video-worker":"dev-video-key","export-pdf-worker":"dev-export-pdf-key","ops":"dev-ops-key"}
# HS256 secret for LOCAL/DEV user-JWT verify (parity collab gateway local = HS256).
# Leave EMPTY in prod and set SUPABASE_URL to use JWKS (RS256/ES256) instead.
SUPABASE_JWT_SECRET=dev-supabase-jwt-secret-change-me
# Prod JWKS source ({SUPABASE_URL}/auth/v1/.well-known/jwks.json). Empty in dev.
SUPABASE_URL=

# --- Buckets / prefixes / caps ---
STORAGE_BUCKETS=storybook-assets
# READ privacy: not served on /files/ (signed GET only). Sync nginx block lines.
STORAGE_PRIVATE_PREFIXES=exports/
# WRITE restriction (orthogonal to the READ list): user-JWT write/delete into these
# prefixes -> 403; S2S unaffected. Everything else is user-writable (denylist model).
# Prod: extend with every service-written tree (ai-logs/, illustrations/, ...).
STORAGE_SERVICE_ONLY_PREFIXES=exports/
STORAGE_MAX_OBJECT_BYTES=52428800
# Longest-prefix match OVERRIDES the global cap above (validation/size_caps.py).
# exports/ = 200MB: 300dpi CMYK PDF ≈ 1.6MB/spread — the 50MB global would 413
# a ~32-spread book at the final PUT of the export pipeline.
STORAGE_PREFIX_SIZE_CAPS={"videos/": 3221225472, "exports/": 209715200}
# User-upload mime policy: mime-prefix -> byte cap, longest match wins. FAIL-CLOSED:
# unlisted mime -> 415 (keeps text/html, image/svg+xml off the public domain).
# New FE media type (e.g. "application/pdf") = one entry here, no deploy.
STORAGE_USER_MIME_CAPS={"image/": 52428800, "audio/": 20971520, "video/": 52428800}
STORAGE_MIN_FREE_BYTES=10737418240

# --- Signed GET dev fallback ---
# Dev-only: when there is NO nginx, stream bytes through the driver on signed GET.
# MUST stay false in prod (prod serves via nginx X-Accel-Redirect).
STORAGE_SIGNED_GET_DEV_STREAM=false

# --- Request / CORS / bind ---
# Comma-separated browser origins allowed on the FastAPI write path
# (POST /uploads, DELETE user-mode). Public read CORS is nginx's job
# (/files/ serves Access-Control-Allow-Origin: * — see deploy/nginx-storage.conf.example).
# "*" is supported and safe here (allow_credentials=False, Bearer auth — CORS is
# not the security boundary), but an explicit allowlist is preferred: adding an
# uploader app is a 1-line env change, no deploy.
CORS_ALLOWED_ORIGINS=http://localhost:5173
HOST=127.0.0.1
PORT=8200
